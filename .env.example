APP_ENV=development
APP_NAME=TicketFlow
SECRET_KEY=change-me-please

DATABASE_URL=postgresql+psycopg://ticketflow:ticketflow@postgres:5432/ticketflow

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=false

CADDY_DOMAIN=localhost
CADDY_ACME_EMAIL=admin@example.com

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_ROLE=admin

# host bind mounts for Debian12
HOST_TICKET_INBOX_DIR=/opt/sirena-olt-client/received-files
HOST_FTP_TICKETS_DIR=/srv/ftp/tickets
HOST_FTP_REALISATIONS_DIR=/srv/ftp/realizations
HOST_FTP_PAYMENTS_DIR=/srv/ftp/payments
HOST_ONEC_REALISATIONS_TARGET_DIR=/mnt/1c-gds
HOST_ONEC_PAYMENTS_SOURCE_DIR=/mnt/1c-payments

TICKET_INBOX_DIR=/opt/sirena-olt-client/received-files
FTP_TICKETS_DIR=/srv/ftp/tickets
FTP_TICKETS_PROCESSED_DIR=/srv/ftp/tickets/processed
FTP_TICKETS_ERROR_DIR=/srv/ftp/tickets/error

FTP_REALISATIONS_DIR=/srv/ftp/realizations
ONEC_REALISATIONS_TARGET_DIR=/mnt/1c-gds
ONEC_REALISATIONS_ARCHIVE_DIR=/mnt/1c-gds/archive
ONEC_REALISATIONS_BAD_DIR=/mnt/1c-gds/bad
ONEC_REALISATIONS_DEL_BAD_DIR=/mnt/1c-gds/del_bad
ONEC_REALISATIONS_EMPTY_DIR=/mnt/1c-gds/empty

ONEC_PAYMENTS_SOURCE_DIR=/mnt/1c-payments
FTP_PAYMENTS_DIR=/srv/ftp/payments
FTP_PAYMENTS_PROCESSED_DIR=/srv/ftp/payments/processed
FTP_PAYMENTS_ERROR_DIR=/srv/ftp/payments/error

FILE_SCAN_INTERVAL_SEC=5
FILE_STABLE_AGE_SEC=3
FILE_SCAN_BATCH_SIZE=250
ARCHIVE_SUCCESS_DELAY_SEC=1800
ARCHIVE_BATCH_SIZE=500
